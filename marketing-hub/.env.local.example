# Copy this file to ".env.local" and fill in the 2 values below.
# Supabase dashboard > "Connect" button (or Project Settings > API Keys)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Optional: max upload size in MB (default 50, the Supabase free plan limit)
# NEXT_PUBLIC_MAX_UPLOAD_MB=50
